<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0</TargetFramework>
    <RollForward>Major</RollForward>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- Purely a CPU bake tool: it references the game for world generation but never
         touches MonoGame's GraphicsDevice, so it runs headless on Linux. -->
    <AssemblyName>orthophoto</AssemblyName>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../../Game.csproj" />
  </ItemGroup>
</Project>
